# Bolsa de Carga MCP - Environment Configuration
# 
# Copy this file to .env and configure for local development
# cp .env.example .env

# API Configuration
# Production: https://api.pro.cargoffer.com (default)
# Local development: http://localhost:8090
API_URL=https://api.pro.cargoffer.com

# API Key - Get from Cargoffer dashboard or request access
# Leave empty for now, set via CLI or integrations
API_KEY=

# Server Port
PORT=3000